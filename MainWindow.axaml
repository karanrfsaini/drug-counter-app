<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DrugCounterApp.MainWindow"
        Title="Drug Counter"
        Width="800" Height="700"
        Background="Black">

    <StackPanel Margin="20" Spacing="20">

        <!-- Title -->
        <TextBlock Text="Drug Counter"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <!-- Acetaminophen -->
        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,10">
            <TextBlock Text="Acetaminophen:"
                       Width="150"
                       FontSize="16"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="AcetaminophenCountText"
                       Text="0"
                       Width="50"
                       FontSize="16"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            <Button Content="Add"
                    Width="80"
                    Padding="5,2"
                    Click="OnAcetaminophenClicked"/>
        </StackPanel>

        <!-- Oxycotin -->
        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,10">
            <TextBlock Text="Oxycotin:"
                       Width="150"
                       FontSize="16"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="OxycotinCountText"
                       Text="0"
                       Width="50"
                       FontSize="16"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            <Button Content="Add"
                    Width="80"
                    Padding="5,2"
                    Click="OnOxycotinClicked"/>
        </StackPanel>

        <!-- Ibuprofen -->
        <StackPanel Orientation="Horizontal" Spacing="15" Margin="0,10">
            <TextBlock Text="Ibuprofen:"
                       Width="150"
                       FontSize="16"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="IbuprofenCountText"
                       Text="0"
                       Width="50"
                       FontSize="16"
                       Foreground="White"
                       VerticalAlignment="Center"/>
            <Button Content="Add"
                    Width="80"
                    Padding="5,2"
                    Click="OnIbuprofenClicked"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="20"
                    Margin="0,30,0,0">
            <Button Content="Reset All"
                    Width="100"
                    Padding="6"
                    Click="OnResetClicked"/>
            <Button Content="View Log"
                    Width="100"
                    Padding="6"
                    Click="OnViewLogClicked"/>
            <Button Content="Exit"
                    Width="100"
                    Padding="6"
                    Click="OnExitClicked"/>
        </StackPanel>

    </StackPanel>
</Window>
