<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DrugCounterApp.MainWindow"
        Title="Drug Counter"
        Width="800" Height="700"
        Background="Black">

    <Grid RowDefinitions="Auto,*,Auto" Margin="20">
        <!-- Title -->
        <TextBlock Grid.Row="0"
                   Text="Drug Counter"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="White"
                   HorizontalAlignment="Center"
                   Margin="0,10"/>

        <!-- Drug Counters Section -->
        <StackPanel Grid.Row="1" Spacing="20">

            <!-- Acetaminophen -->
            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock Text="Acetaminophen:"
                           Width="150"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="AcetaminophenCountText"
                           Text="0"
                           Width="50"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="Add"
                        Width="80"
                        Padding="5,2"
                        HorizontalAlignment="Left"
                        Click="OnAcetaminophenClicked"/>
            </StackPanel>

            <!-- Oxycotin -->
            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock Text="Oxycotin:"
                           Width="150"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="OxycotinCountText"
                           Text="0"
                           Width="50"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="Add"
                        Width="80"
                        Padding="5,2"
                        HorizontalAlignment="Left"
                        Click="OnOxycotinClicked"/>
            </StackPanel>

            <!-- Ibuprofen -->
            <StackPanel Orientation="Horizontal" Spacing="15">
                <TextBlock Text="Ibuprofen:"
                           Width="150"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <TextBlock x:Name="IbuprofenCountText"
                           Text="0"
                           Width="50"
                           FontSize="16"
                           Foreground="White"
                           VerticalAlignment="Center"/>
                <Button Content="Add"
                        Width="80"
                        Padding="5,2"
                        HorizontalAlignment="Left"
                        Click="OnIbuprofenClicked"/>
            </StackPanel>

        </StackPanel>

        <!-- Bottom Buttons -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="20"
                    Margin="0,30,0,0">
            <Button Content="Reset All"
                    Width="100"
                    Padding="6"
                    Click="OnResetClicked"/>
            <Button Content="View Log"
                    Width="100"
                    Padding="6"
                    Click="OnViewLogClicked"/>
            <Button Content="Exit"
                    Width="100"
                    Padding="6"
                    Click="OnExitClicked"/>
        </StackPanel>

    </Grid>
</Window>
