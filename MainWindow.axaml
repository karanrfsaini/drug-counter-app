<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DrugCounterApp.MainWindow"
        Title="Drug Counter"
        Width="400" Height="350">
    <StackPanel Margin="10" Spacing="10">

        <!-- Acetaminophen -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Acetaminophen:" Width="120"/>
            <TextBlock x:Name="AcetaminophenCountText" Text="0" Width="30"/>
            <Button Content="Add" Click="OnAcetaminophenClicked"/>
        </StackPanel>

        <!-- Oxycotin -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Oxycotin:" Width="120"/>
            <TextBlock x:Name="OxycotinCountText" Text="0" Width="30"/>
            <Button Content="Add" Click="OnOxycotinClicked"/>
        </StackPanel>

        <!-- Ibuprofen -->
        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="Ibuprofen:" Width="120"/>
            <TextBlock x:Name="IbuprofenCountText" Text="0" Width="30"/>
            <Button Content="Add" Click="OnIbuprofenClicked"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,20,0,0">
            <Button Content="Reset All" Click="OnResetClicked"/>
            <Button Content="View Log" Click="OnViewLogClicked"/>
            <Button Content="Exit" Click="OnExitClicked"/>
        </StackPanel>

    </StackPanel>
</Window>
